NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
WEB_ORIGINS=["http://localhost:4200"]
BOOKING_TIME_ZONE=Europe/Moscow
PRIVACY_NOTICE_URL=http://localhost:4200/privacy
PRIVACY_NOTICE_VERSION=alpha-1
LEAD_RETENTION_DAYS=90
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-random-characters
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=nexus-media
RESEND_API_KEY=re_replace
RESEND_WEBHOOK_SIGNING_SECRET=whsec_replace
EMAIL_FROM="Nexus <noreply@example.com>"
OUTBOX_ENCRYPTION_KEY=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=
IDEMPOTENCY_HMAC_ACTIVE_KEY_VERSION=1
IDEMPOTENCY_HMAC_KEYRING={"1":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI="}
SITE_CONFIG_ROLLOUT_MODE=V4_COMPAT
